# Mock-only Harbor smoke test image, derived from the qualified task's Python base.
# Node, curl, and the Pi CLI are installed during image build, prior to Harbor's
# restricted agent/verifier execution. Rebuilds still contact upstream registries.
FROM python:3.12.8-slim-bookworm@sha256:2199a62885a12290dc9c5be3ca0681d367576ab7bf037da120e564723292a2f0
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl bash \
    && rm -rf /var/lib/apt/lists/*
ENV NVM_DIR=/root/.nvm
RUN bash -lc 'set -euo pipefail; \
    curl --fail --silent --show-error --location \
      https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.2/install.sh | bash; \
    source "$NVM_DIR/nvm.sh"; \
    nvm install 22.23.5; \
    nvm alias default 22.23.5; \
    npm install -g --ignore-scripts @earendil-works/pi-coding-agent@0.85.1; \
    pi --version'
WORKDIR /app
COPY allocate.py /app/allocate.py
