# Test-only pinned Pi runtime. Image tag is not digest pinned.
FROM node:22-bookworm-slim
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@0.85.1
WORKDIR /work
ENV PI_CODING_AGENT_DIR=/tmp/pi-config
# Seed data stays in the read-only image; Pi writes auth state only under /tmp.
COPY tests/network/pi_models.json /pi-config-seed/models.json
